# 複製成 .env 後修改；.env 不要 commit 進 git
SECRET_KEY=請改成一串很長的隨機字串
# 預設使用 PostgreSQL；把這行註解掉就改用 instance/medsupply.db（SQLite）
DATABASE_URL=postgresql+psycopg://postgres:<密碼>@localhost:5432/medsupply
# 其他資料庫：
# Oracle（TCPS 加密連線；協定要寫在 dsn 裡，用 service_name= 會被組成一般 TCP）
# DATABASE_URL=oracle+oracledb://帳號:密碼@/?dsn=tcps://主機:2484/服務名稱
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/medsupply?charset=utf8mb4
# DATABASE_URL=mssql+pyodbc://user:password@localhost/medsupply?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# 設成 1 會印出每一句 SQL（除錯用）
SQL_ECHO=0
LOG_LEVEL=INFO
